# Database Config
POSTGRES_DB=your_database_name_here
POSTGRES_USER=your_database_username_here
POSTGRES_PASSWORD=your_database_password_here
DB_PORT=your_database_port_here

# pgAdmin Config
PGADMIN_EMAIL=your_pgadmin_email_here
PGADMIN_PASSWORD=your_pgadmin_password_here


# Mail SMTP
MAIL_USERNAME=your_system_email@gmail.com
MAIL_PASSWORD=your_app_password

MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here
# ========================
# JWT CONFIG
# ========================
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173
INTERNAL_API_KEY=replace_with_a_long_random_internal_service_key

# ========================
# CLOUDINARY
# ========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# VNPAY SANDBOX
# Register at: https://sandbox.vnpayment.vn/devreg/
# Never commit real merchant credentials.
# ========================
VNPAY_TMN_CODE=your_sandbox_tmn_code
VNPAY_HASH_SECRET=your_sandbox_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
# IPN must be publicly reachable when testing server-to-server notifications.
VNPAY_IPN_URL=https://your-public-test-domain/api/v1/payments/vnpay/ipn
VNPAY_FRONTEND_RESULT_URL=http://localhost:5173/payment/result
VNPAY_PAYMENT_TIMEOUT_MINUTES=15
