# ========================
# DATABASE (PostgreSQL)
# ========================
POSTGRES_USER=your_database_username_here
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=your_database_name_here
AUTH_DB_NAME=your_auth_database_name_here
TOUR_DB_NAME=your_tour_database_name_here
DB_PORT=your_database_port_here

# ========================
# PGADMIN
# ========================
PGADMIN_EMAIL=your_pgadmin_email_here
PGADMIN_PASSWORD=your_pgadmin_password_here

# ========================
# REDIS
# ========================
REDIS_HOST=your_redis_host_here
REDIS_PORT=your_redis_port_here

# ========================
# CORS
# ========================
CORS_ALLOWED_ORIGINS=your_allowed_origins_here

# ========================
# MAIL (SMTP)
# ========================
MAIL_USERNAME=your_system_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
NOTIFICATION_EMAIL_ENABLED=false

# ========================
# MAPBOX
# ========================
MAPBOX_PUBLIC_TOKEN=your_mapbox_public_token_here
MAPBOX_SECRET_TOKEN=your_mapbox_secret_token_here

# ========================
# GEOLOCATION (Nominatim)
# ========================
NOMINATIM_URL=your_nominatim_url_here

# ========================
# JWT / SECURITY
# ========================
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRATION=your_access_token_expiration_in_ms
JWT_REFRESH_EXPIRATION=your_refresh_token_expiration_in_ms
INTERNAL_API_KEY=replace_with_a_long_random_internal_service_key

# ========================
# CLOUDINARY
# ========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================
# VNPAY SANDBOX
# ========================
VNPAY_PAYMENT_URL=your_vnpay_payment_url_here
VNPAY_RETURN_URL=your_vnpay_return_url_here
VNPAY_IPN_URL=your_vnpay_ipn_url_here
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
